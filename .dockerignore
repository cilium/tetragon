# Ignore everything by default and opt in what the images need, so that local
# build artifacts and scratch files stay out of the context. A new top-level
# path needed by a Dockerfile has to be added below.
*

# Build system
!Makefile
!Makefile.cli
!Makefile.defs

# Go modules and sources
!go.mod
!go.sum
!vendor
!api
!cmd
!operator
!pkg
!tests
!contrib/tetragon-rthooks

# BPF programs
!bpf

# Linux tarball packaging
!install

# Compiled artifacts of a local build living in the directories above
bpf/deps
bpf/objs
contrib/tetragon-rthooks/tetragon-nri-hook
contrib/tetragon-rthooks/tetragon-oci-hook
contrib/tetragon-rthooks/tetragon-oci-hook-setup
tests/vmtests/tetragon-tester
tests/vmtests/tetragon-vmtests-run
tests/vmtests/test-data
tests/vmtests/test-group-*
tests/vmtests/vmtests-results-*
